# Copiar este archivo a .env y rellenar los valores reales (nunca versionar .env)

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Solo cuando la aplicación se sirve detrás de un proxy TLS (un túnel, Nginx,
# un contenedor en un servidor…). Sin estas, validar desde el navegador
# falla por CSRF y Django responde 'DisallowedHost'.
#
# Para enseñar ECO por el túnel de VS Code, descomenta estas tres líneas y
# pon DJANGO_DEBUG=False arriba:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.devtunnels.ms
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.devtunnels.ms
# DJANGO_DETRAS_DE_PROXY=True
#
# Para el túnel de Cloudflare, lo mismo cambiando el dominio:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
# DJANGO_DETRAS_DE_PROXY=True

# Base de datos PostgreSQL.
# En un entorno gestionado (Neon, Render…) basta DATABASE_URL, que tiene
# prioridad sobre las variables DB_* de abajo:
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech/eco_db?sslmode=require
DB_NAME=eco_db
DB_USER=eco_user
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432

# Rutas de modelos PLN (sin barra al final)
# es_core_news_sm es el único modelo de spaCy validado/instalado en este
# proyecto — no cambiar sin descargar antes el modelo correspondiente
# (`python -m spacy download <modelo>`) y sin documentar el porqué en la
# bitácora (ver Fase 0 de escalado, 2026-08-19/2026-08-20: un default
# divergente a "es_core_news_md", nunca instalado, pasó inadvertido).
MODELO_SPACY=es_core_news_sm
MODELO_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODELOS_DIR=modelos/

# Semilla aleatoria para reproducibilidad
SEMILLA_ALEATORIA=42

# Usuario administrador/validador que se crea solo en el arranque del
# despliegue (comando `asegurar_admin`). En local se usa createsuperuser.
# DJANGO_SUPERUSER_USERNAME=especialista
# DJANGO_SUPERUSER_PASSWORD=pon-una-clave-larga-aqui
# DJANGO_SUPERUSER_EMAIL=especialista@ejemplo.cu
